# Скопируйте в .env и при необходимости измените значения.
# Реальный .env в репозиторий не попадает (см. .gitignore).
POSTGRES_USER=meetings_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=meetings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Адреса frontend, которым разрешены запросы к API (через запятую)
CORS_ORIGINS=http://localhost:5173
