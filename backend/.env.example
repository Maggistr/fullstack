# Скопируйте в .env и при необходимости измените значения.
# Реальный .env в репозиторий не попадает (см. .gitignore).
POSTGRES_USER=meetings_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=meetings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Адреса frontend, которым разрешены запросы к API (через запятую)
CORS_ORIGINS=http://localhost:5173

# Ключ подписи JWT. Сгенерируйте свой: python -c "import secrets; print(secrets.token_hex(32))"
# Не короче 32 символов; при смене ключа все выданные access token перестают действовать.
JWT_SECRET_KEY=replace_with_long_random_string_at_least_32_chars
# Срок действия access token (минуты) и refresh token (дни)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
